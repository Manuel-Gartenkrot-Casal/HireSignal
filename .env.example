# MongoDB
MONGO_URI=mongodb://localhost:27017/hiresignal
MONGO_DB=hiresignal

# Cron semanal (lunes 8:00 hs local del contenedor)
CRON_HOUR=8
CRON_MINUTE=0

# Google Sheets (Fase 2). Copiar credenciales service account a service-account.json
# y habilitar "Google Sheets API" en el proyecto de GCP.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CREDS=service-account.json